PAPER_TRADING=true
TRADING_ENABLED=false
TV_WEBHOOK_SECRET=replace-with-a-long-random-secret
ALLOWED_SYMBOLS=QQQ,META,MU
MAX_QTY=1
# Crypto is sized separately: 1 is a sane share count and an absurd amount of
# BTC. Decimal, because Alpaca's minimum BTC order is 0.000015548 (~$1) and an
# integer quantity makes 1 whole coin (~$65,000) the smallest possible order.
# Leave at 0 to keep crypto trading disabled.
CRYPTO_MAX_QTY=0
MAX_NOTIONAL=1000
MAX_PRICE_DEVIATION=0.05
MAX_ALERT_AGE_SECONDS=180
GATEWAY_DB_PATH=./gateway.sqlite3
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
ALPACA_STREAM_ENABLED=false
ALPACA_MARKET_DATA_FEED=iex
MARKET_SYMBOLS=QQQ
# Crypto streams from a DIFFERENT endpoint, so its symbols are listed
# separately. The two lists are never merged: MARKET_SYMBOLS is equities only,
# CRYPTO_SYMBOLS is crypto only, slash form.
#
# A crypto pair left in MARKET_SYMBOLS is refused at startup. Alpaca would
# otherwise reject the entire subscription with "invalid syntax", stopping
# quotes for every equity in the list too.
CRYPTO_SYMBOLS=
DISCORD_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
DISCORD_SIGNAL_CHANNEL_ID=
DISCORD_SOURCE_WEBHOOK_ID=
# Use this instead when the approved source is a normal Discord bot user.
DISCORD_SOURCE_BOT_ID=
# Optional: explicit relay bot user ID for self-message suppression.
DISCORD_RELAY_BOT_ID=
GATEWAY_INTERNAL_URL=http://127.0.0.1:8000/webhooks/tradingview/pine/dry-run
